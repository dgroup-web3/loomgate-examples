{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loomgate-playground",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  // The SDK's server entry imports Node's `crypto` (for webhook verification).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is a static file.
    "run_worker_first": ["/api/*"]
  },
  // 60 requests per minute per IP address on /api/* (see worker/index.ts).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
  // Production: examples.loomgate.io (add the custom domain in the Cloudflare dashboard, or uncomment).
  // "routes": [{ "pattern": "examples.loomgate.io", "custom_domain": true }]
  // No Workers Logs / observability on purpose: request logs could record the secret key header.
}
